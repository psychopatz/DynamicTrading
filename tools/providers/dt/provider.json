{
  "schema": "semantic.provider_manifest.v2",
  "providerID": "DTCommon",
  "displayName": "Dynamic Trading",
  "providers": [
    {
      "providerID": "DTCommon",
      "displayName": "Dynamic Trading common contract",
      "repositoryKind": "dynamic_trading",
      "activationIDs": ["DTCommon", "DynamicTradingCommon"],
      "requires": ["PsychopatzCore"],
      "capabilities": ["trading.conversation", "trading.interaction"],
      "materializationModes": ["abstract", "physical"],
      "optional": true,
      "runtimeModules": ["DTCommon"],
      "runtimeBootstrap": [{
        "id": "DTCommon.shared",
        "entrypoint": "${repository}/Contents/mods/DTCommon/${runtime:DTCommon}/media/lua/shared/DTCommon/00_DTCommon_Init.lua",
        "modulePaths": [
          "${repository}/Contents/mods/DTCommon/common/media/lua/shared/?.lua",
          "${repository}/Contents/mods/DTCommon/${runtime:DTCommon}/media/lua/shared/?.lua"
        ],
        "required": true
      }]
    },
    {
      "providerID": "DTAbstract",
      "displayName": "Dynamic Trading abstract",
      "repositoryKind": "dynamic_trading",
      "activationIDs": ["DTAbstract", "DynamicTrading", "DynamicTradingV2"],
      "requires": ["PsychopatzCore", "DTCommon"],
      "conflicts": ["DTHoomans", "ProjectHoomans"],
      "capabilities": [
        "semantic.conversation", "semantic.identity", "semantic.interaction",
        "trading.conversation", "trading.interaction", "trading.remote"
      ],
      "routeClaims": {
        "semantic.conversation": 50,
        "semantic.identity": 50,
        "semantic.interaction": 50,
        "trading.conversation": 100,
        "trading.interaction": 100,
        "trading.remote": 100
      },
      "materializationModes": ["abstract"],
      "optional": true,
      "luaModulePaths": ["${repository}/tools/providers/dt/lua/?.lua"],
      "luaModule": "provider/DTAbstract",
      "runtimeModules": ["DTAbstract"],
      "runtimeBootstrap": [{
        "id": "DTAbstract.shared",
        "entrypoint": "${repository}/Contents/mods/DTAbstract/${runtime:DTAbstract}/media/lua/shared/DTAbstract/00_DTAbstract_Init.lua",
        "modulePaths": [
          "${repository}/Contents/mods/DTAbstract/${runtime:DTAbstract}/media/lua/shared/?.lua"
        ],
        "required": true
      }]
    },
    {
      "providerID": "DTHoomans",
      "displayName": "Dynamic Trading Hoomans",
      "repositoryKind": "dynamic_trading",
      "activationIDs": ["DTHoomans"],
      "requires": ["PsychopatzCore", "ProjectHoomans", "DTCommon"],
      "conflicts": ["DTAbstract"],
      "capabilities": ["trading.conversation", "trading.interaction", "trading.physical"],
      "routeClaims": {
        "trading.conversation": 100,
        "trading.interaction": 100,
        "trading.physical": 100
      },
      "materializationModes": ["physical"],
      "optional": true,
      "luaModulePaths": ["${repository}/tools/providers/dt/lua/?.lua"],
      "luaModule": "provider/DTHoomans",
      "runtimeModules": ["DTHoomans"],
      "runtimeBootstrap": [{
        "id": "DTHoomans.shared",
        "entrypoint": "${repository}/Contents/mods/DTHoomans/${runtime:DTHoomans}/media/lua/shared/DTHoomans/00_DTHoomans_Init.lua",
        "modulePaths": [
          "${repository}/Contents/mods/DTHoomans/${runtime:DTHoomans}/media/lua/shared/?.lua"
        ],
        "required": true
      }],
      "environment": {
        "SEMANTIC_HARNESS_DT_REPOSITORY": "${repository}",
        "PZ_TEST_DYNAMIC_TRADING_RUNTIME": "${runtime:DTCommon}"
      }
    }
  ],
  "conversationSources": [
    "tools/providers/dt/codebuilder/sources/conversation/packs/dynamic_trading.json"
  ]
}
